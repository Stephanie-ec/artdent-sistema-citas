{
  "name": "Art Dent (Jetty + MySQL)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/artdent-sistema-citas",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Art Dent", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "postStartCommand": "bash .devcontainer/arrancar.sh",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack"]
    }
  }
}
