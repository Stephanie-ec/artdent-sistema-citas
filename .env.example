# =====================================================================
# ArtDent - variables de entorno (plantilla sin secretos)
#
# En Railway se definen en la pestaña "Variables" del servicio JSP.
# En local, copia este archivo como .env y ajusta; `.env` está en
# .gitignore y NUNCA debe subirse.
#
# Nombres: ConfigLoader traduce `mail.smtp.host` a ARTDENT_MAIL_SMTP_HOST
# (prefijo ARTDENT_, puntos -> guiones bajos, mayúsculas).
# =====================================================================

# --- Base de datos (Railway: Reference Variables al servicio MySQL) ---
ARTDENT_DB_URL=jdbc:mysql://localhost:3306/db_artdent_apf2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima&useUnicode=true&characterEncoding=UTF-8
ARTDENT_DB_USER=root
ARTDENT_DB_PASSWORD=cambiar

# --- Almacenamiento privado de comprobantes (volumen en Railway: /data) ---
ARTDENT_DATOS_DIR=/data/artdent
ARTDENT_PAGOS_ADJUNTOS_DIR=comprobantes-pagos
ARTDENT_PAGOS_TITULAR=Art Dent
ARTDENT_PAGOS_NUMERO=999999999

# --- Correo (Ethereal para demo; ver docs/CORREO_EN_DESPLIEGUE.md) ---
ARTDENT_MAIL_ENABLED=true
ARTDENT_MAIL_SENDER=pw7nynbvow246yvt@ethereal.email
ARTDENT_MAIL_FROM_NAME=Art Dent
ARTDENT_MAIL_SMTP_USER=pw7nynbvow246yvt@ethereal.email
ARTDENT_MAIL_PASSWORD=cambiar
ARTDENT_MAIL_SMTP_HOST=smtp.ethereal.email
ARTDENT_MAIL_SMTP_PORT=587
ARTDENT_MAIL_SMTP_AUTH=true
ARTDENT_MAIL_SMTP_STARTTLS=true
ARTDENT_MAIL_SMTP_SSL=false
ARTDENT_RECORDATORIOS_ENABLED=true

# --- RENIEC: demo permite reservar sin consultar al proveedor ---
ARTDENT_RENIEC_MODE=demo
ARTDENT_RENIEC_API_URL=
ARTDENT_RENIEC_API_TOKEN=

# --- Asistente virtual (opcional) ---
ARTDENT_GEMINI_ENABLED=false
ARTDENT_GEMINI_API_KEY=
ARTDENT_GEMINI_MODEL=gemini-2.0-flash

# --- Mercado Pago Checkout Pro ---
# Sandbox: credenciales TEST-... / Producción: APP_USR-...
ARTDENT_MP_ENABLED=true
ARTDENT_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
ARTDENT_MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Obligatorio en el servidor: https://<tu-dominio> (sin barra final).
# Si queda vacío se deduce de la petición (sirve en local, no detrás del proxy de Railway).
ARTDENT_MP_BASE_URL=
# Solo para pruebas con un stub local:
ARTDENT_MP_API_URL=
