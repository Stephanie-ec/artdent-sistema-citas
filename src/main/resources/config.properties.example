# Configuración de Base de Datos
db.url=jdbc:mysql://localhost:3306/db_artdent?serverTimezone=America/Lima&useUnicode=true&characterEncoding=UTF-8
db.user=root
db.password=tu_password_aqui

# Configuración de Correo Electrónico (Gmail SMTP)
mail.sender=tu_correo@gmail.com
mail.password=tu_token_o_clave_de_aplicacion
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587

# Configuración de Gemini AI
gemini.api.key=TU_API_KEY_AQUI

# Verificación de DNI en RENIEC (CR-06). Token del proveedor; si se deja vacío, la verificación se desactiva.
reniec.api.url=https://api.decolecta.com/v1/reniec/dni?numero={dni}
reniec.api.token=
